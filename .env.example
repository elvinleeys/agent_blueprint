NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=supabase-secret-key
OPENAI_API_KEY=your-open-ai-key
# 선택: GitHub 공개 저장소 읽기(구현 검사). 공개 저장소만 읽고 다른 권한이 없는 fine-grained 토큰. 없어도 동작(시간당 60번). docs/deploy-checklist.md 1절
GITHUB_TOKEN=
# 구현 검사의 GitHub 저장소 입력. "true"일 때만 켜짐(기본 꺼짐). 켜도 허용 목록(GitHub 숫자 id, 쉼표 구분)의 사용자만. docs/deploy-checklist.md 1절
REPO_CHECK_ENABLED=
REPO_CHECK_ALLOWED_USERS=
